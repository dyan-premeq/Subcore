{
  "name": "modded-rimsage",
  "version": "1.2.2",
  "description": "An MCP server for RimWorld mod development: static reconstruction of the modded def pipeline, C#/Harmony indexing and cross-layer reference lookup.",
  "main": "src/stdio.ts",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dyan-premeq/Modded-RimSage.git"
  },
  "homepage": "https://github.com/dyan-premeq/Modded-RimSage",
  "files": [
    "src"
  ],
  "scripts": {
    "start": "bun src/stdio.ts",
    "start:http": "bun src/http.ts",
    "clean": "bun src/scripts/clean-db.ts",
    "index:defs": "bun src/scripts/index-defs.ts",
    "index:csharp": "bun src/scripts/index-csharp.ts",
    "index:source": "bun src/scripts/index-source.ts",
    "index:patches": "bun src/scripts/index-patches.ts",
    "regression:patches": "bun src/scripts/regression-patches.ts",
    "build": "bun run clean && bun run index:mods && bun run index:defs && bun run index:patches && bun run index:csharp && bun run index:source",
    "type-check": "tsc",
    "index:mods": "bun src/scripts/index-mods.ts",
    "import:mods": "bun src/scripts/import-mods.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "fast-xml-builder": "^1.3.1",
    "fast-xml-parser": "^5.11.1",
    "fontoxpath": "^3.34.0",
    "slimdom": "^4.3.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
